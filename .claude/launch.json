{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "audit-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8770",
        "--directory",
        ".planning/visual-references"
      ],
      "port": 8770
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "-l",
        "8767",
        "."
      ],
      "port": 8767
    },
    {
      "name": "site-raw",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/static-server.mjs",
        "8768"
      ],
      "port": 8768
    },
    {
      "name": "mcp-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--local",
        "--config",
        "mcp-server-the-commons/wrangler.jsonc",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}
