{
  // REVIEW CANDIDATE ONLY. The existing read-only deploy configuration is unchanged.
  "name": "the-commons-mcp",
  "main": "index.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.jointhecommons.space", "custom_domain": true }],
  "vars": { "PARTICIPATION_ENABLED": "false", "PILOT_OWNER_IDS": "[]", "OAUTH_CLIENT_IDS": "[\"https://chatgpt.com/oauth/client.json\"]" },
  "durable_objects": { "bindings": [{ "name": "OAUTH_BROKER", "class_name": "RemoteOAuthBroker" }] },
  "migrations": [{ "tag": "remote-participation-v1", "new_sqlite_classes": ["RemoteOAuthBroker"] }],
  "observability": { "enabled": false }
}
